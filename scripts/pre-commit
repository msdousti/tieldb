#!/bin/bash
# Pre-commit hook for TielDB
# Checks formatting and runs static analysis before allowing commits

set -e

echo "Running pre-commit checks..."

# Get list of staged C/H files
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(c|h)$' || true)

if [ -z "$STAGED_FILES" ]; then
    echo "✅ No C/H files to check"
    exit 0
fi

FORMAT=$(command -v clang-format-22 || command -v clang-format || true)
TIDY=$(command -v clang-tidy-22 || command -v clang-tidy || true)

if [ -z "$FORMAT" ]; then
    echo "⚠️  clang-format not found, skipping format check"
    echo "   Install with: sudo apt install clang-format-22 (Linux) or brew install clang-format (macOS)"
else
    echo "Checking code formatting..."

    FORMAT_ISSUES=$(echo "$STAGED_FILES" | xargs "$FORMAT" --dry-run --Werror 2>&1 || true)

    if [ -n "$FORMAT_ISSUES" ]; then
        echo "❌ Format check failed!"
        echo ""
        echo "The following files need formatting:"
        echo "$FORMAT_ISSUES"
        echo ""
        echo "Run this to fix:"
        echo "  $FORMAT -i $STAGED_FILES"
        echo ""
        exit 1
    fi

    echo "✅ Format check passed"
fi

C_FILES=$(echo "$STAGED_FILES" | grep '\.c$' || true)

if [ -z "$TIDY" ] || [ ! -d "build-asan" ]; then
    echo "⚠️  Skipping clang-tidy (build-asan not found or clang-tidy not installed)"
elif [ -n "$C_FILES" ]; then
    echo "Running clang-tidy..."
    if ! "$TIDY" -p build-asan $C_FILES; then
        echo "❌ clang-tidy failed"
        exit 1
    fi
    echo "✅ clang-tidy passed"
fi

echo ""
echo "✅ All pre-commit checks passed!"
exit 0
