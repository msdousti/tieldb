# EduDB clang-tidy configuration
# Checks for common bugs, performance issues, and style violations

Checks: >
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -readability-identifier-length,
  -readability-function-cognitive-complexity,
  -readability-magic-numbers,
  -bugprone-easily-swappable-parameters,
  -cert-err33-c,
  -misc-unused-parameters,
  -readability-avoid-const-params-in-decls

# Disabled checks explained:
# - identifier-length: we allow short names like 'i', 'j' for loop counters
# - function-cognitive-complexity: too noisy, we have our own complexity rules
# - magic-numbers: too noisy for systems code (PAGE_SIZE, etc.)
# - easily-swappable-parameters: too noisy, types provide safety
# - cert-err33-c: checks all unchecked return values, too aggressive
# - misc-unused-parameters: common in callback interfaces
# - avoid-const-params-in-decls: const on pass-by-value is fine

WarningsAsErrors: '*'

CheckOptions:
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    value: lower_case
  - key: readability-identifier-naming.TypedefCase
    value: lower_case
  - key: readability-identifier-naming.StructCase
    value: lower_case
  - key: readability-identifier-naming.EnumCase
    value: lower_case
  - key: readability-identifier-naming.MacroDefinitionCase
    value: UPPER_CASE
  - key: readability-identifier-naming.EnumConstantCase
    value: UPPER_CASE
  - key: readability-identifier-naming.GlobalConstantCase
    value: UPPER_CASE
  - key: readability-braces-around-statements.ShortStatementLines
    value: 0
  - key: readability-function-size.LineThreshold
    value: 100
  - key: readability-function-size.StatementThreshold
    value: 50
  - key: performance-move-const-arg.CheckTriviallyCopyableMove
    value: false

HeaderFilterRegex: 'src/.*\.h$'
