# EditorConfig for EduDB
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h}]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{md,txt}]
indent_style = space
indent_size = 2
max_line_length = 100
trim_trailing_whitespace = false

[{meson.build,meson_options.txt}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4
